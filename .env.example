# PostgreSQL Database Connection String
DATABASE_URL=postgresql://postgres:postgres@db:5432/secure_auth

# JWT Secret for signing access and challenge tokens
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars

# 32-byte (256-bit) hex-encoded key for AES-256-GCM credential encryption
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development
